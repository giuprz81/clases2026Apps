# Copia este archivo como .env en ESTA carpeta raíz (junto a README.md y .gitignore). .env NO se versiona.
# Reemplaza REEMPLAZAR_LOCALMENTE SOLO dentro de tu .env. Nunca pegues claves en el chat, GitHub, capturas ni logs.
# Las URLs son fijas (servidor Ollama del docente). Las claves te las entrega el docente: nunca las compartas.
LLAMA_BASE_URL=https://ec11t2557.tail7e0f77.ts.net/llama/v1
LLAMA_MODEL=llama3.1:8b
LLAMA_API_KEY=REEMPLAZAR_LOCALMENTE
QWEN_BASE_URL=https://ec11t2557.tail7e0f77.ts.net/qwen/v1
QWEN_MODEL=qwen3-next:80b
QWEN_API_KEY=REEMPLAZAR_LOCALMENTE
# mock = sin red (por defecto). live = usa los modelos (además hay que añadir --modo live a cada comando)
LAB_MODE=mock
# 0 = el docente desactiva el juez live (si el 80B satura el servidor)
LAB_JUEZ_LIVE=1
